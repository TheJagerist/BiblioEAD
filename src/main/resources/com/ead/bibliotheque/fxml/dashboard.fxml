<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER"
            style="-fx-background-color: transparent; -fx-background: transparent;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ead.bibliotheque.controllers.DashboardController"
            styleClass="fond-application"
            stylesheets="@../css/styles.css">
            

    <VBox spacing="20" style="-fx-background-color: transparent;">
        <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

        <!-- EN-TÊTE -->
        <VBox spacing="2" styleClass="entete-dashboard">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label text="Tableau de bord" styleClass="page-titre"/>
            <Label text="Vue d'ensemble — mise à jour aujourd'hui" styleClass="page-sous-titre"/>
        </VBox>

        <!-- LIGNE HERO : emprunts en cours + retards -->
        <HBox spacing="14">

            <VBox styleClass="carte-dos-livre,carte-dos-livre-bleu" spacing="8" HBox.hgrow="ALWAYS">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Emprunts en cours" styleClass="carte-label" HBox.hgrow="ALWAYS"/>
                    <Label text="→" styleClass="carte-icone-bleu"/>
                </HBox>
                <Label fx:id="kpiEmprunts" text="—" styleClass="carte-val"/>
                <HBox styleClass="spark" spacing="3">
                    <Region styleClass="spark-barre" prefHeight="10" HBox.hgrow="ALWAYS"/>
                    <Region styleClass="spark-barre" prefHeight="14" HBox.hgrow="ALWAYS"/>
                    <Region styleClass="spark-barre" prefHeight="18" HBox.hgrow="ALWAYS"/>
                    <Region styleClass="spark-barre" prefHeight="15" HBox.hgrow="ALWAYS"/>
                    <Region styleClass="spark-barre" prefHeight="20" HBox.hgrow="ALWAYS"/>
                    <Region styleClass="spark-barre" prefHeight="24" HBox.hgrow="ALWAYS"/>
                </HBox>
                <Label text="7 derniers jours" styleClass="carte-pied"/>
            </VBox>

            <VBox styleClass="carte-dos-livre,carte-dos-livre-rouge" spacing="8" prefWidth="230">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Retards actifs" styleClass="carte-label" HBox.hgrow="ALWAYS"/>
                    <Label text="⚠" styleClass="carte-icone-rouge"/>
                </HBox>
                <Label fx:id="kpiRetards" text="—" styleClass="carte-val,carte-val-rouge"/>
                <Label text="Plus ancien : 21 j" styleClass="badge-danger"/>
            </VBox>

        </HBox>

        <!-- LIGNE SECONDAIRE : 3 cartes plates -->
        <HBox spacing="14">

            <VBox styleClass="carte-plate" spacing="8" HBox.hgrow="ALWAYS">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <Label text="Adhérents actifs" styleClass="carte-label"/>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="kpiAdherents" text="—" styleClass="carte-val-moyen"/>
                    <HBox spacing="0">
                        <Label text="EN" styleClass="avatar-mini"/>
                        <Label text="LM" styleClass="avatar-mini">
                            <HBox.margin><Insets left="-8"/></HBox.margin>
                        </Label>
                        <Label text="DM" styleClass="avatar-mini">
                            <HBox.margin><Insets left="-8"/></HBox.margin>
                        </Label>
                    </HBox>
                </HBox>
            </VBox>

            <VBox styleClass="carte-plate" spacing="8" HBox.hgrow="ALWAYS">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <Label text="Livres disponibles" styleClass="carte-label"/>
                <HBox alignment="BASELINE_LEFT" spacing="4">
                    <Label fx:id="kpiLivres" text="—" styleClass="carte-val-moyen"/>
                    <Label fx:id="labelLivresTotal" text="/ —" styleClass="carte-val-suffixe"/>
                </HBox>
                <StackPane alignment="CENTER_LEFT" styleClass="barre-progression">
                    <Region fx:id="fondBarreLivres" styleClass="barre-progression-fond" maxWidth="Infinity" prefHeight="4"/>
                    <Region fx:id="barreProgressionLivres" styleClass="barre-progression-remplissage" prefWidth="160" maxWidth="160" prefHeight="4"/>
                </StackPane>
            </VBox>

            <VBox styleClass="carte-plate" spacing="6" HBox.hgrow="ALWAYS">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <Label text="Ce mois" styleClass="carte-label"/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Nouveaux emprunts" styleClass="stat-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statNouveauxEmprunts" text="—" styleClass="stat-val"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Retours effectués" styleClass="stat-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statRetoursEffectues" text="—" styleClass="stat-val"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Nouveaux adhérents" styleClass="stat-label" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="statNouveauxAdherents" text="—" styleClass="stat-val"/>
                </HBox>
            </VBox>

        </HBox>

        <!-- LIGNE BASSE : timeline + genres -->
        <HBox spacing="14">

            <VBox styleClass="carte-timeline" spacing="14" HBox.hgrow="ALWAYS">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Activité récente" styleClass="section-label" HBox.hgrow="ALWAYS"/>
                    <Label text="Voir tout →" styleClass="lien-voir-tout"/>
                </HBox>

                <VBox fx:id="conteneurTimeline" spacing="0"/>

            </VBox>

            <VBox styleClass="carte-genres" spacing="12" prefWidth="230">
                <padding><Insets top="16" right="18" bottom="16" left="18"/></padding>
                <Label text="Genres empruntés" styleClass="section-label"/>

                <VBox spacing="5">
                    <HBox>
                        <Label text="Littérature" styleClass="genre-nom" HBox.hgrow="ALWAYS"/>
                        <Label text="80%" styleClass="genre-pourcentage"/>
                    </HBox>
                    <StackPane alignment="CENTER_LEFT">
                        <Region styleClass="barre-genre-fond,barre-genre-fond-rouge" maxWidth="Infinity" prefHeight="8"/>
                        <Region styleClass="barre-genre-remplissage-rouge" prefWidth="128" maxWidth="128" prefHeight="8"/>
                    </StackPane>
                </VBox>

                <VBox spacing="5">
                    <HBox>
                        <Label text="Sciences" styleClass="genre-nom" HBox.hgrow="ALWAYS"/>
                        <Label text="55%" styleClass="genre-pourcentage"/>
                    </HBox>
                    <StackPane alignment="CENTER_LEFT">
                        <Region styleClass="barre-genre-fond,barre-genre-fond-bleu" maxWidth="Infinity" prefHeight="8"/>
                        <Region styleClass="barre-genre-remplissage-bleu" prefWidth="88" maxWidth="88" prefHeight="8"/>
                    </StackPane>
                </VBox>

                <VBox spacing="5">
                    <HBox>
                        <Label text="Histoire" styleClass="genre-nom" HBox.hgrow="ALWAYS"/>
                        <Label text="35%" styleClass="genre-pourcentage"/>
                    </HBox>
                    <StackPane alignment="CENTER_LEFT">
                        <Region styleClass="barre-genre-fond,barre-genre-fond-gris" maxWidth="Infinity" prefHeight="8"/>
                        <Region styleClass="barre-genre-remplissage-gris" prefWidth="56" maxWidth="56" prefHeight="8"/>
                    </StackPane>
                </VBox>

            </VBox>

        </HBox>

    </VBox>
</ScrollPane>