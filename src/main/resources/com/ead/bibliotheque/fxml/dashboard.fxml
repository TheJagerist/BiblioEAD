<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ead.bibliotheque.controllers.DashboardController"
            styleClass="dashboard-scroll"
            stylesheets="@../css/styles.css">
    <VBox spacing="18" styleClass="dashboard-root">
        <padding><Insets top="26" right="28" bottom="28" left="28"/></padding>
        <HBox alignment="CENTER_LEFT" styleClass="dashboard-intro">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Bonjour, admin" styleClass="dashboard-greeting"/>
                <Label text="Un aperçu vivant de votre bibliothèque, mis à jour aujourd’hui." styleClass="dashboard-subtitle"/>
            </VBox>
            <Label text="✦  Espace administrateur" styleClass="dashboard-status"/>
        </HBox>
        <HBox spacing="18">
            <VBox spacing="14" styleClass="hero-bibliotheque" HBox.hgrow="ALWAYS" minHeight="236">
                <HBox alignment="CENTER_LEFT"><Label text="✦  À la une" styleClass="hero-pill" HBox.hgrow="ALWAYS"/><Label text="📚" styleClass="hero-bookmark"/></HBox>
                <VBox spacing="5" VBox.vgrow="ALWAYS">
                    <Label text="Votre bibliothèque&#10;à portée de main." styleClass="hero-title"/>
                    <Label text="Suivez les emprunts, repérez les retards et gardez votre collection disponible pour chaque lecteur." styleClass="hero-copy" wrapText="true" maxWidth="470"/>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="12"><Label text="Emprunts en cours" styleClass="hero-metric-label"/><Label fx:id="kpiEmprunts" text="—" styleClass="hero-metric-value"/><Label text="en circulation" styleClass="hero-metric-note"/></HBox>
            </VBox>
            <VBox spacing="10" prefWidth="275">
                <VBox styleClass="mini-kpi mini-kpi-alert"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #D0021B 0%, #9E0015 100%); -fx-background-radius: 19;"
                      spacing="4">
                    <padding><Insets top="18" right="18" bottom="16" left="18"/></padding>
                    <Label text="RETARDS À TRAITER" styleClass="mini-kpi-label"/>
                    <HBox alignment="BASELINE_LEFT" spacing="8">
                        <Label fx:id="kpiRetards" text="—" styleClass="mini-kpi-value"/>
                        <Label text="emprunts" styleClass="mini-kpi-note"/>
                    </HBox>
                    <Label text="À relancer dès aujourd’hui" styleClass="mini-kpi-foot"/>
                </VBox>
                <VBox styleClass="mini-kpi"
                      style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #018ABE 0%, #001B48 100%); -fx-background-radius: 19;"
                      spacing="4">
                    <padding><Insets top="18" right="18" bottom="16" left="18"/></padding>
                    <Label text="LECTEURS INSCRITS" styleClass="mini-kpi-label"/>
                    <HBox alignment="BASELINE_LEFT" spacing="8">
                        <Label fx:id="kpiAdherents" text="—" styleClass="mini-kpi-value"/>
                        <Label text="adhérents actifs" styleClass="mini-kpi-note"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
        <HBox spacing="18">
            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT"><Label text="Vue d’ensemble" styleClass="section-title" HBox.hgrow="ALWAYS"/><Label text="Données actuelles" styleClass="section-link"/></HBox>
                <HBox spacing="14">
                    <VBox styleClass="stat-card stat-card-rose"
                          style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #018ABE 0%, #001B48 100%); -fx-background-radius: 20;"
                          spacing="8" HBox.hgrow="ALWAYS">
                        <padding><Insets top="20" right="20" bottom="18" left="20"/></padding>
                        <Label text="LIVRES DISPONIBLES" styleClass="stat-card-label"/>
                        <HBox alignment="BASELINE_LEFT" spacing="5">
                            <Label fx:id="kpiLivres" text="—" styleClass="stat-card-value"/>
                            <Label fx:id="labelLivresTotal" text="/ —" styleClass="stat-card-suffix"/>
                        </HBox>
                        <StackPane alignment="CENTER_LEFT" styleClass="barre-progression">
                            <Region fx:id="fondBarreLivres" styleClass="barre-progression-fond" maxWidth="Infinity" prefHeight="5"/>
                            <Region fx:id="barreProgressionLivres" styleClass="barre-progression-remplissage" prefWidth="160" maxWidth="160" prefHeight="5"/>
                        </StackPane>
                        <Label text="Exemplaires prêts à être empruntés" styleClass="stat-card-foot"/>
                    </VBox>
                    <VBox styleClass="stat-card stat-card-cream"
                          style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-border-color: #E5EDF2; -fx-border-width: 1; -fx-border-radius: 20;"
                          spacing="7" HBox.hgrow="ALWAYS">
                        <padding><Insets top="20" right="20" bottom="18" left="20"/></padding>
                        <Label text="CE MOIS-CI" styleClass="stat-card-label stat-card-label-dark"/>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Nouveaux emprunts" styleClass="stat-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statNouveauxEmprunts" text="—" styleClass="stat-val"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Retours effectués" styleClass="stat-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statRetoursEffectues" text="—" styleClass="stat-val"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Nouveaux adhérents" styleClass="stat-label" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="statNouveauxAdherents" text="—" styleClass="stat-val"/>
                        </HBox>
                    </VBox>
                </HBox>
                <VBox styleClass="activity-card" spacing="14" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT"><Label text="Activité récente" styleClass="section-title" HBox.hgrow="ALWAYS"/><Label text="Mise à jour automatique" styleClass="section-link"/></HBox>
                    <VBox fx:id="conteneurTimeline" spacing="0"/>
                </VBox>
            </VBox>
            <VBox prefWidth="285" spacing="14">
                <Label text="Emprunts par genre" styleClass="section-title"/>
                <VBox styleClass="genres-card" spacing="16">
                    <VBox spacing="6">
                        <HBox><Label fx:id="genreNom1" text="—" styleClass="genre-nom" HBox.hgrow="ALWAYS"/><Label fx:id="genrePct1" text="—%" styleClass="genre-pourcentage"/></HBox>
                        <StackPane alignment="CENTER_LEFT"><Region styleClass="barre-genre-fond" maxWidth="Infinity" prefHeight="8"/><Region fx:id="barreGenre1" styleClass="barre-genre-remplissage-rouge" prefWidth="0" maxWidth="160" prefHeight="8"/></StackPane>
                    </VBox>
                    <VBox spacing="6">
                        <HBox><Label fx:id="genreNom2" text="—" styleClass="genre-nom" HBox.hgrow="ALWAYS"/><Label fx:id="genrePct2" text="—%" styleClass="genre-pourcentage"/></HBox>
                        <StackPane alignment="CENTER_LEFT"><Region styleClass="barre-genre-fond" maxWidth="Infinity" prefHeight="8"/><Region fx:id="barreGenre2" styleClass="barre-genre-remplissage-bleu" prefWidth="0" maxWidth="160" prefHeight="8"/></StackPane>
                    </VBox>
                    <VBox spacing="6">
                        <HBox><Label fx:id="genreNom3" text="—" styleClass="genre-nom" HBox.hgrow="ALWAYS"/><Label fx:id="genrePct3" text="—%" styleClass="genre-pourcentage"/></HBox>
                        <StackPane alignment="CENTER_LEFT"><Region styleClass="barre-genre-fond" maxWidth="Infinity" prefHeight="8"/><Region fx:id="barreGenre3" styleClass="barre-genre-remplissage-gris" prefWidth="0" maxWidth="160" prefHeight="8"/></StackPane>
                    </VBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="Répartition basée sur vos emprunts enregistrés." wrapText="true" styleClass="genres-note"/>
                </VBox>
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>