<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane prefHeight="600" prefWidth="960"
           styleClass="login-root"
           stylesheets="@../css/styles.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ead.bibliotheque.controllers.LoginController">

    <!-- Décors circulaires coins -->
    <Circle radius="120" styleClass="login-decor-circle"
            StackPane.alignment="TOP_LEFT"
            translateX="-60" translateY="-60"/>
    <Circle radius="90" styleClass="login-decor-circle"
            StackPane.alignment="TOP_LEFT"
            translateX="-45" translateY="-45"
            opacity="0.5"/>
    <Circle radius="110" styleClass="login-decor-circle"
            StackPane.alignment="BOTTOM_RIGHT"
            translateX="55" translateY="55"/>
    <Circle radius="80" styleClass="login-decor-circle"
            StackPane.alignment="BOTTOM_RIGHT"
            translateX="40" translateY="40"
            opacity="0.5"/>
    <Circle radius="60" styleClass="login-decor-circle"
            StackPane.alignment="TOP_RIGHT"
            translateX="30" translateY="-30"
            opacity="0.35"/>
    <Circle radius="50" styleClass="login-decor-circle"
            StackPane.alignment="BOTTOM_LEFT"
            translateX="-25" translateY="25"
            opacity="0.35"/>

    <!-- Contenu centré -->
    <VBox alignment="CENTER" spacing="24" maxWidth="560">

        <!-- Logo -->
        <StackPane styleClass="login-logo-wrapper">
            <ImageView fitHeight="64" fitWidth="64" preserveRatio="true">
                <image><Image url="@../images/logo_ead.png"/></image>
            </ImageView>
        </StackPane>

        <!-- Titre + sous-titre -->
        <VBox alignment="CENTER" spacing="6">
            <Label styleClass="login-title" text="Connexion"/>
            <Label styleClass="login-subtitle" text="Bibliothèque EAD — Groupe 4"/>
        </VBox>

        <!-- Champs côte à côte -->
        <HBox spacing="16" alignment="CENTER">
            <VBox spacing="0" styleClass="login-field-box" HBox.hgrow="ALWAYS">
                <Label styleClass="login-field-icon" text="👤"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label styleClass="login-field-label" text="Identifiant"/>
                    <TextField fx:id="usernameField"
                               promptText="Entrez votre identifiant"
                               styleClass="login-field-inner"/>
                </VBox>
            </VBox>
            <VBox spacing="0" styleClass="login-field-box" HBox.hgrow="ALWAYS">
                <Label styleClass="login-field-icon" text="👁"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label styleClass="login-field-label" text="Mot de passe"/>
                    <PasswordField fx:id="passwordField"
                                   promptText="••••••••"
                                   styleClass="login-field-inner"/>
                </VBox>
            </VBox>
        </HBox>

        <!-- Erreur -->
        <Label fx:id="errorLabel" managed="false" maxWidth="480"
               styleClass="login-error" text="" visible="false" wrapText="true"/>

        <!-- Bouton -->
        <Button fx:id="loginButton" defaultButton="true"
                onAction="#onSoumettre"
                prefWidth="480" prefHeight="46"
                styleClass="btn-login"
                text="SE CONNECTER"/>

        <!-- Lien oublié -->
        <Hyperlink styleClass="login-link" text="Mot de passe oublié ?" onAction="#onMotDePasseOublie"/>

        <!-- Texte bas -->
        <Label styleClass="login-bottom-text" maxWidth="400" textAlignment="CENTER" wrapText="true"
               text="Bienvenue ! Gérez votre bibliothèque scolaire dans un seul espace centralisé."/>

    </VBox>
</StackPane>