<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ead.bibliotheque.controllers.MenuPrincipalController"
            fx:id="rootPane"
            styleClass="app-shell"
            stylesheets="@../css/styles.css">

    <!-- SIDEBAR GAUCHE -->
    <left>
        <VBox styleClass="barre-laterale" prefWidth="220">

            <StackPane styleClass="titre-module" prefHeight="82">
                <VBox alignment="CENTER" spacing="3">
                    <ImageView fitWidth="60" fitHeight="60" preserveRatio="true">
                        <image>
                            <Image url="@../images/logo_ead.png"/>
                        </image>
                    </ImageView>
                    <Text text="BiblioEAD" styleClass="brand-name"/>
                </VBox>
            </StackPane>

            <!-- Navigation principale -->
            <VBox spacing="8" VBox.vgrow="ALWAYS" styleClass="nav-zone">
            <padding><Insets top="22" right="14" bottom="14" left="14"/></padding>

                <Label text="NAVIGATION" styleClass="nav-caption"/>

                <Button fx:id="btnDashboard" id="btnDashboard" text="▦   Tableau de bord"
                        styleClass="lien-navigation"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        onAction="#handleNav">
                </Button>

                <Button fx:id="btnAdherents" id="btnAdherents" text="♟   Adhérents"
                        styleClass="lien-navigation"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        onAction="#handleNav">
                </Button>

                <Button fx:id="btnCatalogue" id="btnCatalogue" text="▤   Catalogue"
                        styleClass="lien-navigation"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        onAction="#handleNav">
                </Button>

                <Button fx:id="btnEmprunts" id="btnEmprunts" text="↻   Activités"
                        styleClass="lien-navigation"
                        maxWidth="Infinity" alignment="CENTER_LEFT"
                        onAction="#handleNav">
                </Button>
            </VBox>

            <VBox spacing="8" styleClass="nav-footer">
                <Label text="ADMINISTRATION" styleClass="nav-caption"/>
                <Button fx:id="btnParametres" id="btnParametres" text="⚙   Gestion des admins"
                        styleClass="lien-navigation" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#handleNav"/>
                <Button fx:id="btnDeconnexion" id="btnDeconnexion" text="↗   Déconnexion"
                        styleClass="bouton-action nav-logout" maxWidth="Infinity" onAction="#handleDeconnexion"/>
            </VBox>

        </VBox>
    </left>

    <!-- ZONE PRINCIPALE -->
    <center>
        <VBox styleClass="zone-contenu">

            <!-- TOPBAR -->
            <HBox styleClass="barre-actions" alignment="CENTER_LEFT" spacing="12" prefHeight="88"
                  onMousePressed="#handleDebutDeplacement" onMouseDragged="#handleDeplacement">
                <padding><Insets top="13" right="28" bottom="9" left="28"/></padding>
                <VBox spacing="1">
                    <Label text="BIBLIOTHÈQUE SCOLAIRE" styleClass="topbar-caption"/>
                    <Label fx:id="labelTitreVue" text="Tableau de bord" styleClass="topbar-title"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <HBox fx:id="hboxProfil" alignment="CENTER" spacing="9" styleClass="profil-compact" focusTraversable="true">
                    <StackPane prefWidth="38" prefHeight="38" styleClass="avatar-admin">
                        <Label fx:id="labelAvatar" text="AB" styleClass="avatar-admin-text"/>
                    </StackPane>
                    <Label fx:id="labelAdmin" text="Admin Biblio" styleClass="admin-name"/>
                </HBox>
                <HBox spacing="3" styleClass="window-controls">
                    <Button text="—" styleClass="window-control" onAction="#handleMinimiser"/>
                    <Button text="□" styleClass="window-control" onAction="#handleMaximiser"/>
                    <Button text="×" styleClass="window-control window-control-close" onAction="#handleFermer"/>
                </HBox>
            </HBox>

            <!-- CONTENU DYNAMIQUE -->
            <StackPane fx:id="contenuPrincipal" VBox.vgrow="ALWAYS" styleClass="contenu-principal">
                <!-- Les vues (Dashboard, Adhérents, etc.) seront chargées ici via FXMLLoader -->
            </StackPane>

        </VBox>
    </center>

</BorderPane>
