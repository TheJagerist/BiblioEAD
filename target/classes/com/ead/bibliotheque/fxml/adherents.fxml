<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ead.bibliotheque.controllers.AdherentsController"
      styleClass="fond-application"
      VBox.vgrow="ALWAYS">

    <!-- ===== ZONE LISTE ===== -->
    <VBox spacing="12" HBox.hgrow="ALWAYS">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="fieldRecherche"
                       promptText="Rechercher par nom, prénom, n° carte..."
                       styleClass="champ-recherche"
                       HBox.hgrow="ALWAYS"
                       onKeyReleased="#onRecherche"/>
            <ComboBox fx:id="comboFiliere"
                      promptText="Filière"
                      styleClass="bouton-action"
                      prefWidth="120"
                      onAction="#onFiltreFiliere"/>
            <Button text="Ajouter"
                    styleClass="bouton-principal"
                    onAction="#onNouvelAdherent"/>
        </HBox>

        <TableView fx:id="tableAdherents" VBox.vgrow="ALWAYS"
                   onMouseClicked="#onSelectionLigne">
            <columns>
                <TableColumn fx:id="colNom"         text="Nom"         prefWidth="150"/>
                <TableColumn fx:id="colPrenom"      text="Prénom"      prefWidth="130"/>
                <TableColumn fx:id="colClasse"      text="Classe"      prefWidth="80"/>
                <TableColumn fx:id="colFiliere"     text="Filière"     prefWidth="130"/>
                <TableColumn fx:id="colNumCarte"    text="N° carte"    prefWidth="110"/>
                <TableColumn fx:id="colInscription" text="Inscription" prefWidth="110"/>
                <TableColumn fx:id="colModifiePar" text="Modifié par" prefWidth="120"/>
                <TableColumn fx:id="colModifieLe"  text="Modifié le"  prefWidth="130"/>
            </columns>
            <placeholder><Label text="Aucun adhérent trouvé."/></placeholder>
        </TableView>

        <HBox spacing="8">
            <Button fx:id="btnModifier"   text="Modifier"            styleClass="bouton-action"         disable="true" onAction="#onModifier"/>
            <Button fx:id="btnSupprimer"  text="Supprimer"           styleClass="bouton-action-danger"  disable="true" onAction="#onSupprimer"/>
            <Button fx:id="btnHistorique" text="Historique emprunts" styleClass="bouton-action"         disable="true" onAction="#onHistorique"/>
        </HBox>
    </VBox>

    <!-- ===== PANNEAU LATÉRAL ===== -->
    <VBox fx:id="panneauFormulaire" prefWidth="500"
          styleClass="panneau-lateral"
          managed="false" visible="false">

        <HBox alignment="CENTER_LEFT" styleClass="panneau-lateral-header">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <Label fx:id="labelTitrePanneau" text="Nouvel adhérent"
                   styleClass="section-label" HBox.hgrow="ALWAYS"/>
            <Button text="✕" styleClass="bouton-action" onAction="#onFermerPanneau"/>
        </HBox>

        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <VBox spacing="4">
                <Label text="NOM" styleClass="form-field-label"/>
                <TextField fx:id="fieldNom" styleClass="champ-recherche" promptText="Nom de famille"/>
            </VBox>
            <VBox spacing="4">
                <Label text="PRÉNOM" styleClass="form-field-label"/>
                <TextField fx:id="fieldPrenom" styleClass="champ-recherche" promptText="Prénom"/>
            </VBox>
            <VBox spacing="4">
                <Label text="ANNÉE" styleClass="form-field-label"/>
                <ComboBox fx:id="comboAnnee" styleClass="champ-recherche" maxWidth="Infinity"
                          onAction="#onAnneeOuFiliereChange"/>
            </VBox>
            <VBox fx:id="blocAnnee" spacing="4">
                <Label text="CLASSE (auto)" styleClass="form-field-label"/>
                <HBox styleClass="champ-auto" alignment="CENTER_LEFT" spacing="8">
                    <padding><Insets top="7" right="10" bottom="7" left="10"/></padding>
                    <Label fx:id="labelClasseAuto" text="— auto —"
                           styleClass="lien-navigation" HBox.hgrow="ALWAYS"/>
                    <Label text="🔒" style="-fx-font-size:11px;"/>
                </HBox>
            </VBox>
            <VBox spacing="4">
                <Label text="FILIÈRE" styleClass="form-field-label"/>
                <ComboBox fx:id="comboFiliereForm" styleClass="champ-recherche" maxWidth="Infinity"
                          onAction="#onAnneeOuFiliereChange"/>
            </VBox>
            <VBox spacing="4">
                <Label text="N° CARTE (auto)" styleClass="form-field-label"/>
                <HBox styleClass="champ-auto" alignment="CENTER_LEFT" spacing="8">
                    <padding><Insets top="7" right="10" bottom="7" left="10"/></padding>
                    <Label fx:id="labelNumCarte" text="— auto —"
                           styleClass="lien-navigation" HBox.hgrow="ALWAYS"/>
                    <Label text="🔒" style="-fx-font-size:11px;"/>
                </HBox>
            </VBox>
            <VBox spacing="4">
                <Label text="DATE D'INSCRIPTION" styleClass="form-field-label"/>
                <DatePicker fx:id="dateInscription" maxWidth="Infinity" styleClass="champ-recherche"/>
            </VBox>

            <Label fx:id="labelErreur" styleClass="label-erreur"
                   text="" wrapText="true" maxWidth="218"
                   visible="false" managed="false"/>
        </VBox>

        <HBox spacing="8" styleClass="panneau-lateral-footer">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="Annuler" styleClass="bouton-action"
                    onAction="#onFermerPanneau"/>
            <Button fx:id="btnSauvegarder" text="Enregistrer"
                    styleClass="bouton-principal" onAction="#onSauvegarder"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>

</HBox>