<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ead.bibliotheque.controllers.CatalogueController"
      styleClass="fond-application">

    <!-- ===== ZONE PRINCIPALE ===== -->
    <VBox HBox.hgrow="ALWAYS" spacing="12">
    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

        <!-- Toolbar -->
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
    <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <TextField fx:id="fieldRecherche"
                       promptText="Titre, auteur, ISBN, genre..."
                       styleClass="champ-recherche"
                       HBox.hgrow="ALWAYS"
                       onKeyReleased="#onRecherche"/>
            <ComboBox fx:id="comboGenre"
                      promptText="Genre"
                      styleClass="bouton-action"
                      prefWidth="120"
                      onAction="#onFiltreGenre"/>
            <CheckBox fx:id="checkDispo"
                      text="Disponible"
                      styleClass="lien-navigation"
                      onAction="#onFiltreDispo"/>
            <Button text="Ajouter"
                    styleClass="bouton-principal"
                    onAction="#onNouveauLivre"/>
        </HBox>

        <!-- Section nouveautés -->
        <VBox spacing="6" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
    <padding><Insets top="12" right="12" bottom="12" left="12"/></padding>
            <padding><Insets top="0" right="16" bottom="10" left="16"/></padding>
            <Label text="✦  AJOUTÉS CETTE SEMAINE" styleClass="section-label"/>
            <ScrollPane hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
            fitToHeight="true" prefHeight="370"
            style="-fx-background-color: transparent; -fx-background: transparent;">
                <HBox fx:id="boxNouveautes" spacing="12">
                    <padding><Insets top="2" bottom="4"/></padding>
                </HBox>
            </ScrollPane>
        </VBox>

        <!-- Tableau -->
        <Label text="TOUS LES LIVRES" styleClass="section-label" style="-fx-background-color: white; -fx-background-radius: 6; -fx-padding: 10 16 10 16;"/>
        <VBox VBox.vgrow="ALWAYS" spacing="0" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 10, 0, 0, 3);">
        <TableView fx:id="tableCatalogue" VBox.vgrow="ALWAYS"
                   onMouseClicked="#onSelectionLigne">
            <columns>
                <TableColumn fx:id="colTitre"  text="Titre"  prefWidth="260"/>
                <TableColumn fx:id="colAuteur" text="Auteur" prefWidth="160"/>
                <TableColumn fx:id="colGenre"  text="Genre"  prefWidth="110"/>
                <TableColumn fx:id="colAnnee"  text="Année"  prefWidth="70"/>
                <TableColumn fx:id="colIsbn"   text="ISBN"   prefWidth="130"/>
                <TableColumn fx:id="colDispo"  text="Dispo"  prefWidth="80"/>
                <TableColumn fx:id="colModifiePar" text="Modifié par" prefWidth="120"/>
                <TableColumn fx:id="colModifieLe"  text="Modifié le"  prefWidth="130"/>
            </columns>
            <placeholder><Label text="Aucun livre trouvé."/></placeholder>
        </TableView>
        </VBox>

        <!-- Barre d'actions -->
        <HBox spacing="8" styleClass="panneau-lateral-footer">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Button fx:id="btnModifier"    text="Modifier"              styleClass="bouton-action"        disable="true" onAction="#onModifier"/>
            <Button fx:id="btnSupprimer"   text="Supprimer"             styleClass="bouton-action-danger" disable="true" onAction="#onSupprimer"/>
        </HBox>
    </VBox>

    <!-- ===== PANNEAU LATÉRAL ===== -->
    <VBox fx:id="panneauFormulaire" prefWidth="500"
          styleClass="panneau-lateral"
          managed="false" visible="false">

        <HBox alignment="CENTER_LEFT" styleClass="panneau-lateral-header">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <Label fx:id="labelTitrePanneau" text="Nouveau livre"
                   styleClass="section-label" HBox.hgrow="ALWAYS"/>
            <Button text="✕" styleClass="bouton-action" onAction="#onFermerPanneau"/>
        </HBox>

        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" hbarPolicy="NEVER">
        <VBox spacing="12">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <VBox spacing="4">
                <Label text="TITRE" styleClass="form-field-label"/>
                <TextField fx:id="fieldTitre" styleClass="champ-recherche" promptText="Titre du livre"/>
            </VBox>
            <VBox spacing="4">
                <Label text="AUTEUR" styleClass="form-field-label"/>
                <TextField fx:id="fieldAuteur" styleClass="champ-recherche" promptText="Nom de l'auteur"/>
            </VBox>
            <VBox spacing="4">
                <Label text="GENRE" styleClass="form-field-label"/>
                <ComboBox fx:id="comboGenreForm" styleClass="champ-recherche" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="4">
                <Label text="ANNÉE" styleClass="form-field-label"/>
                <TextField fx:id="fieldAnnee" styleClass="champ-recherche" promptText="Ex : 2024"/>
            </VBox>
            <VBox spacing="4">
                <Label text="ISBN" styleClass="form-field-label"/>
                <TextField fx:id="fieldIsbn" styleClass="champ-recherche" promptText="978-..."/>
            </VBox>
            <VBox spacing="4">
                <Label text="IMAGE DE COUVERTURE (facultatif)" styleClass="form-field-label"/>
                <HBox spacing="6" alignment="CENTER_LEFT">
                    <TextField fx:id="fieldImageCouverture"
                        styleClass="champ-recherche"
                        promptText="Chemin ou URL de l'image"
                        HBox.hgrow="ALWAYS"
                        onKeyReleased="#onImageUrlChange"/>
                    <Button text="📁" styleClass="bouton-action"
                            onAction="#onChoisirImage"/>
                </HBox>
                <StackPane fx:id="previewCouverture" prefWidth="80" prefHeight="110"
                           alignment="CENTER">
                    <Label fx:id="labelPreviewVide" text="Aperçu"
                           style="-fx-text-fill:#aaaaaa; -fx-font-size:10px;"/>
                    <ImageView fx:id="imagePreview" fitWidth="80" fitHeight="110"
                               preserveRatio="true" visible="false"/>
                </StackPane>
            </VBox>
            <VBox spacing="4">
                <Label text="NB. EXEMPLAIRES" styleClass="form-field-label"/>
                <Spinner fx:id="spinnerExemplaires" min="1" max="20" initialValue="1"
                         styleClass="champ-recherche" maxWidth="Infinity"/>
            </VBox>

            <Label fx:id="labelErreur" styleClass="label-erreur"
                   text="" wrapText="true" maxWidth="228"
                   visible="false" managed="false"/>
        </VBox>
        </ScrollPane>

        <HBox spacing="8" styleClass="panneau-lateral-footer">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="Annuler" styleClass="bouton-action" onAction="#onFermerPanneau"/>
            <Button fx:id="btnSauvegarder" text="Enregistrer"
                    styleClass="bouton-principal" onAction="#onSauvegarder"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>
    </VBox>

</HBox>