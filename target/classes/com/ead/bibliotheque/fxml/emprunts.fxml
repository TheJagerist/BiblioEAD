<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ead.bibliotheque.controllers.EmpruntsController"
      styleClass="fond-application"
      VBox.vgrow="ALWAYS">

    <!-- ===== ZONE PRINCIPALE ===== -->
    <VBox HBox.hgrow="ALWAYS">
        <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 styleClass="emprunts-tabpane" VBox.vgrow="ALWAYS">
            <tabs>

                <!-- ── EN COURS ── -->
                <Tab fx:id="tabEnCours" text="En cours" onSelectionChanged="#onTabChange">
                    <content>
                        <VBox spacing="12" styleClass="fond-application">
                            <padding><Insets top="12" right="0" bottom="8" left="0"/></padding>
                            <HBox fx:id="kpiBarEnCours" spacing="12">
                            <VBox styleClass="kpi-card" spacing="4" HBox.hgrow="ALWAYS">
                                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                <Label text="Emprunts en cours" styleClass="kpi-label"/>
                                <Label fx:id="kpiEnCoursTotal" text="—" styleClass="kpi-val,kpi-val-blue"/>
                            </VBox>
                            <VBox styleClass="kpi-card" spacing="4" HBox.hgrow="ALWAYS">
                                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                <Label text="À rendre cette semaine" styleClass="kpi-label"/>
                                <Label fx:id="kpiARendreSemaine" text="—" styleClass="kpi-val,kpi-val-amber"/>
                            </VBox>
                            <VBox styleClass="kpi-card" spacing="4" HBox.hgrow="ALWAYS">
                                <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                <Label text="Total livres empruntés" styleClass="kpi-label"/>
                                <Label fx:id="kpiTotalLivres" text="—" styleClass="kpi-val"/>
                            </VBox>
                        </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="fieldRecherche"
                                           promptText="Adhérent, titre, n° carte..."
                                           styleClass="champ-recherche"
                                           HBox.hgrow="ALWAYS"
                                           onKeyReleased="#onRecherche"/>
                                <Button fx:id="btnNouvelEmprunt"
                                        text="Enregistrer un emprunt"
                                        styleClass="bouton-principal"
                                        onAction="#onNouvelEmprunt"/>
                            </HBox>
                            <TableView fx:id="tableEmprunts" VBox.vgrow="ALWAYS"
                                       onMouseClicked="#onSelectionLigne">
                                <columns>
                                    <TableColumn fx:id="colAdherent"      text="Adhérent"       prefWidth="170"/>
                                    <TableColumn fx:id="colLivre"         text="Livre"          prefWidth="190"/>
                                    <TableColumn fx:id="colDateEmprunt"   text="Date emprunt"   prefWidth="110"/>
                                    <TableColumn fx:id="colDateRetour"    text="Retour prévu"   prefWidth="110"/>
                                    <TableColumn fx:id="colJoursRestants" text="Jours restants" prefWidth="110"/>
                                    <TableColumn fx:id="colStatut"        text="Statut"         prefWidth="100"/>
                                </columns>
                                <placeholder><Label text="Aucun emprunt en cours."/></placeholder>
                            </TableView>
                            <HBox spacing="8">
                                <Button fx:id="btnRetour" text="Enregistrer le retour"
                                        styleClass="bouton-action" disable="true"
                                        onAction="#onEnregistrerRetour"/>
                                <Button fx:id="btnHistoriqueAdherent" text="Voir historique adhérent"
                                        styleClass="bouton-action" disable="true"
                                        onAction="#onVoirHistorique"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <!-- ── RETARDS ── -->
                <Tab fx:id="tabRetards" text="Retards" onSelectionChanged="#onTabChange">
                    <content>
                        <VBox spacing="12" styleClass="fond-application">
                            <padding><Insets top="12" right="0" bottom="8" left="0"/></padding>
                            <HBox fx:id="kpiBar" spacing="12">
                                <VBox styleClass="kpi-card" spacing="4" HBox.hgrow="ALWAYS">
                                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                    <Label text="Retards actifs" styleClass="kpi-label"/>
                                    <Label fx:id="kpiRetardsActifs" text="—" styleClass="kpi-val,kpi-val-red"/>
                                </VBox>
                                <VBox styleClass="kpi-card" spacing="4" HBox.hgrow="ALWAYS">
                                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                    <Label text="Jours cumulés" styleClass="kpi-label"/>
                                    <Label fx:id="kpiJoursCumules" text="—" styleClass="kpi-val,kpi-val-amber"/>
                                </VBox>
                                <VBox styleClass="kpi-card" spacing="4" HBox.hgrow="ALWAYS">
                                    <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
                                    <Label text="Plus ancien retard" styleClass="kpi-label"/>
                                    <Label fx:id="kpiRetardMax" text="—" styleClass="kpi-val,kpi-val-blue"/>
                                </VBox>
                            </HBox>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <TextField fx:id="fieldRechercheRetards"
                                           promptText="Adhérent, livre..."
                                           styleClass="champ-recherche"
                                           HBox.hgrow="ALWAYS"
                                           onKeyReleased="#onRechercheRetards"/>
                                <ComboBox fx:id="comboSeverite"
                                          promptText="Sévérité"
                                          styleClass="bouton-action"
                                          prefWidth="130"
                                          onAction="#onFiltreSeverite"/>
                            </HBox>
                            <TableView fx:id="tableRetards" VBox.vgrow="ALWAYS"
                                       onMouseClicked="#onSelectionLigneRetard">
                                <columns>
                                    <TableColumn fx:id="colAdherentR"      text="Adhérent"       prefWidth="170"/>
                                    <TableColumn fx:id="colLivreR"         text="Livre"          prefWidth="190"/>
                                    <TableColumn fx:id="colDateEmpruntR"   text="Date emprunt"   prefWidth="110"/>
                                    <TableColumn fx:id="colDateRetourR"    text="Retour prévu"   prefWidth="110"/>
                                    <TableColumn fx:id="colJoursRestantsR" text="Jours restants" prefWidth="110"/>
                                    <TableColumn fx:id="colSeverite"       text="Sévérité"       prefWidth="100"/>
                                </columns>
                                <placeholder><Label text="Aucun retard actif. 🎉"/></placeholder>
                            </TableView>
                            <HBox spacing="8">
                                <Button fx:id="btnRetourRetard" text="Enregistrer le retour"
                                        styleClass="bouton-action" disable="true"
                                        onAction="#onEnregistrerRetour"/>
                                <Button fx:id="btnRelancer" text="Relancer l'adhérent"
                                        styleClass="bouton-action" disable="true"
                                        onAction="#onRelancer"/>
                            </HBox>
                        </VBox>
                    </content>
                </Tab>

                <!-- ── HISTORIQUE ── -->
                <Tab fx:id="tabHistorique" text="Historique" onSelectionChanged="#onTabChange">
                    <content>
                        <VBox spacing="12" styleClass="fond-application">
                            <padding><Insets top="12" right="0" bottom="8" left="0"/></padding>
                            <TextField fx:id="fieldRechercheHisto"
                                       promptText="Adhérent, titre, n° carte..."
                                       styleClass="champ-recherche"
                                       onKeyReleased="#onRechercheHisto"/>
                            <TableView fx:id="tableHistorique" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colAdherentH"    text="Adhérent"     prefWidth="170"/>
                                    <TableColumn fx:id="colLivreH"       text="Livre"        prefWidth="190"/>
                                    <TableColumn fx:id="colDateEmpruntH" text="Date emprunt" prefWidth="110"/>
                                    <TableColumn fx:id="colDateRetourH"  text="Retour prévu" prefWidth="110"/>
                                    <TableColumn fx:id="colStatutH"      text="Statut"       prefWidth="100"/>
                                </columns>
                                <placeholder><Label text="Aucun historique."/></placeholder>
                            </TableView>
                        </VBox>
                    </content>
                </Tab>

            </tabs>
        </TabPane>
    </VBox>

    <!-- ===== PANNEAU LATÉRAL ===== -->
    <VBox fx:id="panneauFormulaire" prefWidth="260"
          styleClass="panneau-lateral"
          managed="false" visible="false">

        <HBox alignment="CENTER_LEFT" styleClass="panneau-lateral-header">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
            <Label fx:id="labelTitrePanneau" text="Nouvel emprunt"
                   styleClass="section-label" HBox.hgrow="ALWAYS"/>
            <Button text="✕" styleClass="bouton-action" onAction="#onFermerPanneau"/>
        </HBox>

        <VBox spacing="12" VBox.vgrow="ALWAYS">
            <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>

            <!-- Contenu emprunt -->
            <VBox fx:id="contenuEmprunt" spacing="12">
                <VBox spacing="4">
                    <Label text="ADHÉRENT" styleClass="form-field-label"/>
                    <ComboBox fx:id="comboAdherent" promptText="Sélectionner..."
                              styleClass="champ-recherche" maxWidth="Infinity"
                              editable="true" onAction="#onAdherentChange"/>
                </VBox>
                <VBox fx:id="blocRG03" spacing="4" styleClass="verif-bloc"
                      managed="false" visible="false">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <Label text="VÉRIFICATION RG-03" styleClass="form-field-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Emprunts en cours :" styleClass="kpi-label"/>
                        <Label fx:id="labelQuota" text="— / 3" styleClass="lien-navigation"/>
                    </HBox>
                    <Label fx:id="labelRetardAdherent" text="" styleClass="label-erreur"
                           wrapText="true" visible="false" managed="false"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="LIVRE" styleClass="form-field-label"/>
                    <ComboBox fx:id="comboLivre" promptText="Sélectionner..."
                              styleClass="champ-recherche" maxWidth="Infinity"
                              editable="true" onAction="#onLivreChange"/>
                </VBox>
                <VBox fx:id="blocRG01" spacing="4" styleClass="verif-bloc"
                      managed="false" visible="false">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <Label text="VÉRIFICATION RG-01" styleClass="form-field-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Exemplaires disponibles :" styleClass="kpi-label"/>
                        <Label fx:id="labelDispo" text="—" styleClass="lien-navigation"/>
                    </HBox>
                </VBox>
                <VBox spacing="4">
                    <Label text="DATE D'EMPRUNT" styleClass="form-field-label"/>
                    <TextField fx:id="fieldDateEmprunt" styleClass="champ-recherche" editable="false"/>
                </VBox>
                <VBox spacing="4">
                    <Label text="DATE DE RETOUR PRÉVUE (RG-02 : +14 j)" styleClass="form-field-label"/>
                    <HBox styleClass="champ-auto" alignment="CENTER_LEFT" spacing="8">
                        <padding><Insets top="7" right="10" bottom="7" left="10"/></padding>
                        <Label fx:id="labelDateRetour" text="— auto —"
                               styleClass="lien-navigation" HBox.hgrow="ALWAYS"/>
                        <Label text="🔒" style="-fx-font-size:11px;"/>
                    </HBox>
                </VBox>
                <Label fx:id="labelErreur" styleClass="label-erreur"
                       text="" wrapText="true" maxWidth="228"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Contenu fiche retard -->
            <VBox fx:id="contenuFicheRetard" spacing="12" managed="false" visible="false">
                <VBox spacing="2">
                    <Label fx:id="labelNomAdherent" text="—"
                           style="-fx-font-size:13px; -fx-font-weight:bold;"/>
                    <Label fx:id="labelInfoAdherent" text="—" styleClass="kpi-label"/>
                </VBox>
                <Label text="DÉTAIL DU RETARD" styleClass="form-field-label"/>
                <VBox styleClass="verif-bloc" spacing="6">
                    <padding><Insets top="8" right="10" bottom="8" left="10"/></padding>
                    <HBox><Label text="Livre : " styleClass="kpi-label"/><Label fx:id="labelFicheTitre" text="—"/></HBox>
                    <HBox><Label text="Auteur : " styleClass="kpi-label"/><Label fx:id="labelFicheAuteur" text="—"/></HBox>
                    <HBox><Label text="Emprunté le : " styleClass="kpi-label"/><Label fx:id="labelFicheEmprunt" text="—"/></HBox>
                    <HBox><Label text="Retour prévu : " styleClass="kpi-label"/>
                        <Label fx:id="labelFicheRetourPrevu" text="—" styleClass="kpi-val-red"/></HBox>
                    <HBox><Label text="Retard actuel : " styleClass="kpi-label"/>
                        <Label fx:id="labelFicheRetardJours" text="—" styleClass="kpi-val-red"/></HBox>
                </VBox>
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label text="SÉVÉRITÉ" styleClass="form-field-label"/>
                    <Label fx:id="labelFicheSeverite" text="—" styleClass="lien-navigation"/>
                </HBox>
            </VBox>
        </VBox>

        <HBox fx:id="footerEmprunt" spacing="8" styleClass="panneau-lateral-footer">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="Annuler" styleClass="bouton-action" onAction="#onFermerPanneau"/>
            <Button fx:id="btnConfirmer" text="Confirmer"
                    styleClass="bouton-principal" onAction="#onConfirmerEmprunt"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

        <VBox fx:id="footerRetard" spacing="8" styleClass="panneau-lateral-footer"
              managed="false" visible="false">
            <padding><Insets top="12" right="16" bottom="12" left="16"/></padding>
            <Button text="Enregistrer le retour" styleClass="bouton-principal"
                    maxWidth="Infinity" onAction="#onEnregistrerRetour"/>
            <Button text="Relancer l'adhérent" styleClass="bouton-action"
                    maxWidth="Infinity" onAction="#onRelancer"/>
        </VBox>

    </VBox>

</HBox>